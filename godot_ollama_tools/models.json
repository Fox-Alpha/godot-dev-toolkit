  "test_profiles": {
    "smoke-csharp": {
      "kind": "csharp",
      "profile": "smoke",
      "label": "C# smoke test",
      "goal": "Schneller Load- und Syntax-Smoke-Test",
      "prompt": "Write a minimal C# Hello World program as a single file.\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\n"
    },
    "function-csharp": {
      "kind": "csharp",
      "profile": "function",
      "label": "C# function test",
      "goal": "Kurzer Funktions- und Rueckgabewert-Test",
      "prompt": "Write a minimal C# code example that defines static int SumPositive(int[] values).\nThe method must return the sum of all positive integers in the array.\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\n"
    },
    "strict-csharp": {
      "kind": "csharp",
      "profile": "strict",
      "label": "C# strict format test",
      "goal": "Prueft strikte Einhaltung eines knappen Ausgabeformats",
      "prompt": "Write only a C# method with this exact signature: static bool IsEven(int value)\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\nDo not wrap the method in a class.\n"
    },
    "smoke-gdscript": {
      "kind": "gdscript",
      "profile": "smoke",
      "label": "GDScript smoke test",
      "goal": "Schneller Godot-4-Smoke-Test",
      "prompt": "Write a minimal Godot 4 GDScript example that extends Node, uses typed variables, and prints Hello World in _ready().\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\nUse func _ready() -> void:.\n"
    },
    "function-gdscript": {
      "kind": "gdscript",
      "profile": "function",
      "label": "GDScript function test",
      "goal": "Kurzer typisierter Funktions-Test fuer Godot 4",
      "prompt": "Write a minimal Godot 4 GDScript example that extends Node and defines func sum_positive(values: Array[int]) -> int:\nThe function must return the sum of all positive integers in the array.\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\n"
    },
    "strict-gdscript": {
      "kind": "gdscript",
      "profile": "strict",
      "label": "GDScript strict format test",
      "goal": "Prueft strikte Godot-4-Ausgabe ohne Zusatzstruktur",
      "prompt": "Write only a Godot 4 GDScript function with this exact signature: func is_even(value: int) -> bool:\nReturn plain source code only.\nDo not add explanations.\nDo not use markdown code fences.\nDo not include extends or _ready.\n"
    }
